{
  "manifest_version": 3,
  "name": "Mezba Download Manager",
  "version": "0.1.2",
  "description": "Video quality and audio selection, file downloads, and a lightweight Linux download queue.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "contextMenus",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mezba Download Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "choices.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
